    {
      "parameters": {
        "jsCode": "const metrics = $json.body.metrics;\nconst currentCTR = metrics.clicks / metrics.emails_sent;\nconst isUnderperforming = currentCTR < metrics.target_ctr;\n\nreturn {\n  json: {\n    campaignId: metrics.campaign_id,\n    currentCTR: (currentCTR * 100).toFixed(2) + \"%\",\n    targetCTR: (metrics.target_ctr * 100) + \"%\",\n    isAnomaly: isUnderperforming,\n    message: isUnderperforming ? \"🚨 Alert: Low CTR detected!\" : \"Performance Normal.\"\n  }\n};"
      },
