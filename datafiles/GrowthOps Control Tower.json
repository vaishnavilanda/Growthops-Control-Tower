    {
      "parameters": {
        "jsCode": "// Extract text output from Claude\nconst contentArr = $json.content;\nconst textBlock = contentArr.find(c => c.type === 'text') || contentArr[0];\nlet rawText = textBlock.text;\n\n// Clean markdown wrappers and parse JSON\nrawText = rawText.replace(/```json/gi, '').replace(/```/g, '').trim();\nconst parsed = JSON.parse(rawText);\n\n// Extract original campaign info from the Switch node\nconst campaign = $('Switch').item.json.body.campaign_details;\n\nreturn {\n  json: {\n    campaignId: campaign.campaign_id,\n    campaignName: campaign.campaign_name,\n    qaStatus: parsed.qa_status,\n    severity: parsed.severity,\n    flaggedIssues: parsed.flagged_issues.join(\" | \"),\n    actionableFix: parsed.actionable_fix\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        992,
        -256
      ],
      "id": "22152eb7-1a58-4f2e-97a2-6d832e1cf84e",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "sendTo": "landavaishnavi6@gmail.com",
        "subject": "= GrowthOps QA Alert: [{{ $json.severity }}] {{ $json.campaignName }} ({{ $json.qaStatus }})",
        "emailType": "text",
        "message": "=GrowthOps Control Tower - Pre-Launch QA Alert  A campaign submission has failed QA automated checks and requires immediate action.  -------------------------------------------------- CAMPAIGN SUMMARY -------------------------------------------------- • Campaign ID:   {{ $json.campaignId }} • Campaign Name: {{ $json.campaignName }} • QA Status:     {{ $json.qaStatus }} • Severity:      {{ $json.severity }}  -------------------------------------------------- FLAGGED ISSUES -------------------------------------------------- {{ $json.flaggedIssues }}  -------------------------------------------------- ACTIONABLE FIX REQUIRED -------------------------------------------------- {{ $json.actionableFix }}  -------------------------------------------------- GrowthOps Control Tower Engine",
        "options": {}
      },
