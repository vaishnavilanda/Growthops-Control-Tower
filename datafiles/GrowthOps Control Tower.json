        "messages": {
          "values": [
            {
              "content": "You are an elite GrowthOps QA Inspector. Audit the incoming campaign details for critical errors, GDPR compliance issues, missing UTMs, and segment risks.\n\nEvaluation Rules:\n1. Compliance: 'has_unsubscribe_link' MUST be true. If false, flag as CRITICAL.\n2. Audience: Flag any 'audience_segment' that targets unsubscribed or opt-out lists as CRITICAL.\n3. UTMs: Check if 'landing_page_url' contains valid UTM parameters.\n\nReturn strictly valid JSON with no markdown block wrappers:\n{\n  \"qa_status\": \"FAILED\",\n  \"severity\": \"CRITICAL\",\n  \"flagged_issues\": [\"Missing unsubscribe link\", \"Targeting unsubscribed contacts\"],\n  \"actionable_fix\": \"Add footer unsubscribe link and remove unsubscribed contacts from audience segment.\"\n}"
            },
            {
              "content": "=Audit this campaign payload:\n{{ JSON.stringify($json.body.campaign_details) }}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        640,
        -240
      ],
      "id": "b94f9ce9-2688-4c6f-97a8-c9a90646cb0c",
      "name": "Message a model",
