    {
      "parameters": {
        "jsCode": "\n// Extract campaign payload from Switch node\nconst data = $('Switch').item.json.body.campaign_details;\n\n// Audit logic for consent and suppression\nlet hasViolation = false;\nlet violationReason = \"\";\n\nif (data.consent_status === \"opted_out\") {\n  hasViolation = true;\n  violationReason = \"Contact has opted out but is targeted for a campaign.\";\n} else if (data.target_region === \"EU\" && data.consent_status !== \"explicit_opt_in\") {\n  hasViolation = true;\n  violationReason = \"EU GDPR violation: Contact lacks explicit opt-in consent.\";\n} else {\n  violationReason = \"Passed consent audit.\";\n}\n\nreturn {\n  json: {\n    campaignId: data.campaign_id,\n    contactEmail: data.contact_email,\n    targetRegion: data.target_region,\n    consentStatus: data.consent_status,\n    isSuppressedViolation: hasViolation,\n    reason: violationReason\n  }\n};"
      },
